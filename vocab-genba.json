{"level": "現場", "count": 125, "words": [{"word": "安全第一", "reading": "あんぜんだいいち", "meaning": "safety first", "category": "安全", "level": "現場", "kanji": ["安", "全", "第", "一"], "meaning_id": "utamakan keselamatan", "meaning_ja": "けがを しないことが いちばん大事、という考え方。"}, {"word": "立入禁止", "reading": "たちいりきんし", "meaning": "no entry, keep out", "category": "安全", "level": "現場", "kanji": ["立", "入", "禁", "止"], "meaning_id": "dilarang masuk", "meaning_ja": "入っては いけない、という しるし。", "caution": "ロープや 札が あったら 入りません。近道でも 通りません。", "caution_id": "Jika ada tali atau papan, jangan masuk. Jangan lewat walau lebih dekat."}, {"word": "関係者以外立入禁止", "reading": "かんけいしゃいがいたちいりきんし", "meaning": "authorized personnel only", "category": "安全", "level": "現場", "kanji": ["関", "係", "者", "以", "外", "立", "入", "禁", "止"], "meaning_id": "dilarang masuk selain petugas berwenang", "meaning_ja": "その仕事の人 以外は 入ってはいけない、という しるし。"}, {"word": "火気厳禁", "reading": "かきげんきん", "meaning": "no open flames", "category": "安全", "level": "現場", "kanji": ["火", "気", "厳", "禁"], "meaning_id": "dilarang menyalakan api", "meaning_ja": "火を 使っては いけない、という しるし。", "caution": "たばこも いけません。ガスや 油の近くに 多い 掲示です。", "caution_id": "Merokok pun dilarang. Tanda ini banyak di dekat gas atau minyak."}, {"word": "感電", "reading": "かんでん", "meaning": "electric shock", "category": "製造", "level": "現場", "kanji": ["感", "電"], "meaning_id": "tersengat listrik", "meaning_ja": "電気が 体に 流れること。", "caution": "水にぬれた手で さわりません。", "caution_id": "Jangan sentuh dengan tangan basah."}, {"word": "高電圧", "reading": "こうでんあつ", "meaning": "high voltage", "category": "製造", "level": "現場", "kanji": ["高", "電", "圧"], "meaning_id": "tegangan tinggi", "meaning_ja": "強い 電気が 流れている、という しるし。", "caution": "近づきません。ふたを 開けません。", "caution_id": "Jangan mendekat. Jangan membuka penutupnya."}, {"word": "頭上注意", "reading": "ずじょうちゅうい", "meaning": "watch your head", "category": "安全", "level": "現場", "kanji": ["頭", "上", "注", "意"], "meaning_id": "awas kepala", "meaning_ja": "上に 気をつけて、という しるし。頭を ぶつけやすい所。"}, {"word": "足元注意", "reading": "あしもとちゅうい", "meaning": "watch your step", "category": "安全", "level": "現場", "kanji": ["足", "元", "注", "意"], "meaning_id": "awas langkah, perhatikan kaki", "meaning_ja": "足もとに 気をつけて、という しるし。段差や ぬれた所。"}, {"word": "転倒", "reading": "てんとう", "meaning": "falling over, tripping", "category": "安全", "level": "現場", "kanji": ["転", "倒"], "meaning_id": "terjatuh, tersandung", "meaning_ja": "転ぶこと。"}, {"word": "転落", "reading": "てんらく", "meaning": "falling from a height", "category": "安全", "level": "現場", "kanji": ["転", "落"], "meaning_id": "jatuh dari ketinggian", "meaning_ja": "高い所から 落ちること。"}, {"word": "落下物", "reading": "らっかぶつ", "meaning": "falling object", "category": "安全", "level": "現場", "kanji": ["落", "下", "物"], "meaning_id": "benda jatuh", "meaning_ja": "上から 落ちてくる もの。"}, {"word": "開口部", "reading": "かいこうぶ", "meaning": "floor opening", "category": "製造", "level": "現場", "kanji": ["開", "口", "部"], "meaning_id": "lubang/bukaan lantai", "meaning_ja": "ゆかや かべに あいた 穴。", "caution": "ふたが ないときは 近づきません。すぐ 人に 知らせます。", "caution_id": "Jika tidak ada penutup, jangan mendekat. Segera beri tahu orang lain."}, {"word": "高所作業", "reading": "こうしょさぎょう", "meaning": "work at height", "category": "製造", "level": "現場", "kanji": ["高", "所", "作", "業"], "meaning_id": "kerja di ketinggian", "meaning_ja": "高い所で する 仕事。", "caution": "研修を 受けた人だけが します。安全帯を つけます。", "caution_id": "Hanya yang sudah dilatih. Wajib memakai sabuk pengaman."}, {"word": "巻き込まれ", "reading": "まきこまれ", "meaning": "getting caught in machinery", "category": "製造", "level": "現場", "kanji": ["巻", "込"], "meaning_id": "terjerat/tergulung mesin", "meaning_ja": "機械に 体や服が 引きこまれる 事故。", "caution": "動いている機械に 手を入れません。必ず 止めてから。", "caution_id": "Jangan masukkan tangan ke mesin yang berjalan. Hentikan dulu."}, {"word": "挟まれ", "reading": "はさまれ", "meaning": "getting pinched, crushed", "category": "製造", "level": "現場", "kanji": ["挟"], "meaning_id": "terjepit", "meaning_ja": "物と物の あいだに はさまれる 事故。"}, {"word": "緊急停止", "reading": "きんきゅうていし", "meaning": "emergency stop", "category": "安全", "level": "現場", "kanji": ["緊", "急", "停", "止"], "meaning_id": "berhenti darurat", "meaning_ja": "あぶないときに すぐ 機械を 止めること。", "caution": "赤いボタンの 場所を 先に 覚えておきます。", "caution_id": "Hafalkan lebih dulu letak tombol merahnya."}, {"word": "非常口", "reading": "ひじょうぐち", "meaning": "emergency exit", "category": "安全", "level": "現場", "kanji": ["非", "常", "口"], "meaning_id": "pintu darurat", "meaning_ja": "火事などのとき、外へ にげる 出口。", "caution": "前に 物を 置きません。場所を 覚えておきます。", "caution_id": "Jangan menaruh barang di depannya. Hafalkan letaknya."}, {"word": "避難", "reading": "ひなん", "meaning": "evacuation", "category": "安全", "level": "現場", "kanji": ["避", "難"], "meaning_id": "evakuasi", "meaning_ja": "あぶない所から にげること。"}, {"word": "避難訓練", "reading": "ひなんくんれん", "meaning": "evacuation drill", "category": "安全", "level": "現場", "kanji": ["避", "難", "訓", "練"], "meaning_id": "latihan evakuasi", "meaning_ja": "にげる練習。ほんとうの ときのために する。"}, {"word": "消火器", "reading": "しょうかき", "meaning": "fire extinguisher", "category": "安全", "level": "現場", "kanji": ["消", "火", "器"], "meaning_id": "alat pemadam api", "meaning_ja": "火を 消す 道具。"}, {"word": "救急箱", "reading": "きゅうきゅうばこ", "meaning": "first aid kit", "category": "安全", "level": "現場", "kanji": ["救", "急", "箱"], "meaning_id": "kotak P3K", "meaning_ja": "けがの手当てのものを 入れた 箱。"}, {"word": "応急手当", "reading": "おうきゅうてあて", "meaning": "first aid", "category": "安全", "level": "現場", "kanji": ["応", "急", "手", "当"], "meaning_id": "pertolongan pertama", "meaning_ja": "けがのとき、その場で する 手当て。"}, {"word": "労働災害", "reading": "ろうどうさいがい", "meaning": "work-related accident", "category": "安全", "level": "現場", "kanji": ["労", "働", "災", "害"], "meaning_id": "kecelakaan kerja", "meaning_ja": "仕事で 起きた けがや 病気。", "caution": "小さなけがでも 必ず 報告します。あとで 労災が 使えなくなります。", "caution_id": "Sekecil apa pun cedera wajib dilaporkan. Jika tidak, asuransi kerja bisa tidak berlaku."}, {"word": "労災", "reading": "ろうさい", "meaning": "industrial accident (insurance)", "category": "安全", "level": "現場", "kanji": ["労", "災"], "meaning_id": "kecelakaan kerja (asuransi)", "meaning_ja": "労働災害のこと。仕事のけがを 保険で みる しくみ。"}, {"word": "安全衛生", "reading": "あんぜんえいせい", "meaning": "occupational safety and health", "category": "安全", "level": "現場", "kanji": ["安", "全", "衛", "生"], "meaning_id": "keselamatan dan kesehatan kerja", "meaning_ja": "安全と 健康を 守ること。"}, {"word": "保護具", "reading": "ほごぐ", "meaning": "protective equipment", "category": "安全", "level": "現場", "kanji": ["保", "護", "具"], "meaning_id": "alat pelindung diri", "meaning_ja": "体を 守るために つける もの。"}, {"word": "保護帽", "reading": "ほごぼう", "meaning": "safety helmet", "category": "製造", "level": "現場", "kanji": ["保", "護", "帽"], "meaning_id": "helm keselamatan", "meaning_ja": "頭を 守る かたい ぼうし。ヘルメット。"}, {"word": "安全靴", "reading": "あんぜんぐつ", "meaning": "safety shoes", "category": "安全", "level": "現場", "kanji": ["安", "全", "靴"], "meaning_id": "sepatu keselamatan", "meaning_ja": "つま先に 鉄が 入った くつ。"}, {"word": "安全帯", "reading": "あんぜんたい", "meaning": "safety harness", "category": "製造", "level": "現場", "kanji": ["安", "全", "帯"], "meaning_id": "sabuk pengaman", "meaning_ja": "高い所で 体を つなぐ ベルト。"}, {"word": "防護服", "reading": "ぼうごふく", "meaning": "protective clothing", "category": "製造", "level": "現場", "kanji": ["防", "護", "服"], "meaning_id": "pakaian pelindung", "meaning_ja": "体を 守る 服。"}, {"word": "保護眼鏡", "reading": "ほごめがね", "meaning": "safety goggles", "category": "製造", "level": "現場", "kanji": ["保", "護", "眼", "鏡"], "meaning_id": "kacamata pelindung", "meaning_ja": "目を 守る めがね。"}, {"word": "耳栓", "reading": "みみせん", "meaning": "earplugs", "category": "製造", "level": "現場", "kanji": ["耳", "栓"], "meaning_id": "penyumbat telinga", "meaning_ja": "大きな音から 耳を 守る もの。"}, {"word": "防塵マスク", "reading": "ぼうじんますく", "meaning": "dust mask", "category": "製造", "level": "現場", "kanji": ["防", "塵"], "meaning_id": "masker debu", "meaning_ja": "ほこりを すわないための マスク。"}, {"word": "点検", "reading": "てんけん", "meaning": "inspection, check", "category": "作業", "level": "現場", "kanji": ["点", "検"], "meaning_id": "pemeriksaan", "meaning_ja": "こわれていないか 調べること。"}, {"word": "始業前点検", "reading": "しぎょうまえてんけん", "meaning": "pre-work inspection", "category": "製造", "level": "現場", "kanji": ["始", "業", "前", "点", "検"], "meaning_id": "pemeriksaan sebelum mulai kerja", "meaning_ja": "仕事を 始める前に する 点検。"}, {"word": "作業手順", "reading": "さぎょうてじゅん", "meaning": "work procedure", "category": "作業", "level": "現場", "kanji": ["作", "業", "手", "順"], "meaning_id": "prosedur kerja", "meaning_ja": "どの順番で するかの 決まり。", "caution": "自分で 順番を 変えません。変えると 事故になります。", "caution_id": "Jangan ubah urutannya sendiri. Mengubahnya menyebabkan kecelakaan."}, {"word": "作業服", "reading": "さぎょうふく", "meaning": "work clothes", "category": "作業", "level": "現場", "kanji": ["作", "業", "服"], "meaning_id": "pakaian kerja", "meaning_ja": "仕事のときに 着る 服。"}, {"word": "指示", "reading": "しじ", "meaning": "instruction, order", "category": "作業", "level": "現場", "kanji": ["指", "示"], "meaning_id": "instruksi, perintah", "meaning_ja": "「こうしてください」という 言いつけ。", "caution": "分からないときは その場で 聞きます。分かったふりを しません。", "caution_id": "Jika tidak paham, tanyakan saat itu juga. Jangan pura-pura paham."}, {"word": "整理整頓", "reading": "せいりせいとん", "meaning": "tidiness and order (5S)", "category": "作業", "level": "現場", "kanji": ["整", "理", "整", "頓"], "meaning_id": "kerapian dan keteraturan (5S)", "meaning_ja": "いらない物を 捨て、使う物を 決まった所に 置くこと。"}, {"word": "清掃", "reading": "せいそう", "meaning": "cleaning", "category": "作業", "level": "現場", "kanji": ["清", "掃"], "meaning_id": "pembersihan", "meaning_ja": "そうじを すること。"}, {"word": "終了", "reading": "しゅうりょう", "meaning": "end, completion", "category": "作業", "level": "現場", "kanji": ["終", "了"], "meaning_id": "selesai, penyelesaian", "meaning_ja": "終わること。"}, {"word": "交代", "reading": "こうたい", "meaning": "shift change, taking turns", "category": "作業", "level": "現場", "kanji": ["交", "代"], "meaning_id": "pergantian shift, bergiliran", "meaning_ja": "つぎの人と 代わること。"}, {"word": "運搬", "reading": "うんぱん", "meaning": "transport, carrying", "category": "作業", "level": "現場", "kanji": ["